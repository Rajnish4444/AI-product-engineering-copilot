# =============================================================================
# BuildPilot environment variables — copy to .env.local and fill in
# =============================================================================
# See docs/runbook.md for a walk of how to obtain each value.

# -----------------------------------------------------------------------------
# NextAuth (user login)
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# GitHub OAuth App — user login
# Create at: https://github.com/settings/developers
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_OAUTH_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# GitHub App (repo access)
# -----------------------------------------------------------------------------
# Create at: GitHub Settings → Developer settings → GitHub Apps
# See docs/runbook.md for required permissions.
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""   # newline-encoded PEM: replace \n with \\n
GITHUB_APP_WEBHOOK_SECRET=""

# -----------------------------------------------------------------------------
# Model provider selection
# -----------------------------------------------------------------------------
# One of: anthropic | google | github-models
BUILDPILOT_PROVIDER="anthropic"

# Provider keys — only the one matching BUILDPILOT_PROVIDER is required
ANTHROPIC_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""
GITHUB_MODELS_TOKEN=""

# -----------------------------------------------------------------------------
# Cost and safety caps (see ADR-0007)
# -----------------------------------------------------------------------------
BUILDPILOT_SESSION_TOKEN_CAP="200000"
BUILDPILOT_USER_DAILY_TOKEN_CAP="2000000"
BUILDPILOT_DISPATCH_COST_CAP_USD="2.00"
EVAL_COST_CAP_USD="2.00"
